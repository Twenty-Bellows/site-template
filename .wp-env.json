{
	"core": null,
	"port": 8888,
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/create-block-theme.zip",
		"https://downloads.wordpress.org/plugin/pattern-builder.zip"
	],
	"themes": [
	],
        "mappings": { 
            "wp-content/plugins": "./wp-content/plugins",
            "wp-content/themes": "./wp-content/themes" ,
            "wp-content/uploads": "./wp-content/uploads" 
        },
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate template-theme && wp-env run cli wp plugin activate template-plugin"
	},
	"config": {
		"WP_UPLOAD_MAX_FILESIZE": "128M",
		"WP_MEMORY_LIMIT": "256M",
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEVELOPMENT_MODE": "all"
	}
}


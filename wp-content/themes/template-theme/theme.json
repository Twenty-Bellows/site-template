{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#f5f5f5",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#e8e8e8",
					"name": "Surface Muted",
					"slug": "surface-muted"
				},
				{
					"color": "#1a1a1a",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#666666",
					"name": "Text Muted",
					"slug": "text-muted"
				},
				{
					"color": "#333333",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#000000",
					"name": "Primary Hover",
					"slug": "primary-hover"
				},
				{
					"color": "#4a4a4a",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#d4d4d4",
					"name": "Hairline",
					"slug": "hairline"
				}
			],
			"gradients": [
				{
					"name": "Primary",
					"slug": "primary",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-hover) 100%)"
				},
				{
					"name": "Surface Fade",
					"slug": "surface-fade",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--base) 0%, var(--wp--preset--color--surface) 100%)"
				},
				{
					"name": "Inverse",
					"slug": "inverse",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--contrast) 0%, var(--wp--preset--color--primary) 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "64rem"
		},
		"position": {
			"sticky": true
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"size": "0.44rem",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "0.67rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "1rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "1.5rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "2.25rem",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "3.38rem",
					"slug": "70"
				},
				{
					"name": "2X-Large",
					"size": "5.06rem",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System",
					"slug": "system"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Extra Small",
					"size": "0.75rem",
					"slug": "x-small"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "0.8125rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					},
					"name": "Medium",
					"size": "1.25rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					},
					"name": "Large",
					"size": "2.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "2.625rem"
					},
					"name": "Extra Large",
					"size": "2.625rem",
					"slug": "x-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "480px",
			"tablet": "782px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Natural",
					"slug": "natural",
					"shadow": "6px 6px 9px rgba(0, 0, 0, 0.2)"
				},
				{
					"name": "Sharp",
					"slug": "sharp",
					"shadow": "6px 6px 0px rgba(0, 0, 0, 0.2)"
				},
				{
					"name": "Crisp",
					"slug": "crisp",
					"shadow": "6px 6px 0px var(--wp--preset--color--contrast)"
				},
				{
					"name": "Deep",
					"slug": "deep",
					"shadow": "12px 12px 50px rgba(0, 0, 0, 0.4)"
				},
				{
					"name": "Outlined",
					"slug": "outlined",
					"shadow": "6px 6px 0px -3px var(--wp--preset--color--base), 6px 6px var(--wp--preset--color--contrast)"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--hairline)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontSize": "clamp(1rem, 1rem, 1rem)"
				},
				"shadow": "none"
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.5rem, 1.9545rem + 2.727vw, 4rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(2.0625rem, 1.6989rem + 1.818vw, 3.0625rem)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.5455rem + 1.023vw, 2.3125rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "clamp(1.4375rem, 1.3239rem + 0.568vw, 1.75rem)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "clamp(1.1875rem, 1.142rem + 0.227vw, 1.3125rem)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "clamp(1rem, 1rem, 1rem)"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"bottom": "0px",
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "clamp(1rem, 1rem, 1rem)",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
